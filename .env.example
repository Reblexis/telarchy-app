# ── Required ────────────────────────────────────────────────────────────────

# Master API key — keep secret. Used for admin access and cron endpoints.
# Generate with: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# Firebase service account JSON, base64-encoded.
# Required when running outside Google Cloud (local Docker, VPS, Railway, etc.).
# On Google Cloud Run / GCE, leave empty — Application Default Credentials are used automatically.
# Generate: Firebase console → Project settings → Service accounts → Generate new private key
# Encode: base64 -w0 serviceAccount.json
DATA_SERVICE_ACCOUNT=

# ── Optional ─────────────────────────────────────────────────────────────────

# Restrict CORS to your frontend origin. Defaults to * (any origin) if unset.
# Example: ALLOWED_ORIGIN=https://telarchy.com
ALLOWED_ORIGIN=

# Comma-separated email addresses that receive admin access via Firebase Auth.
# Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=

# HTTP port (default: 8080)
PORT=8080

# ── Cron (self-hosted only) ──────────────────────────────────────────────────
# On standalone deployments, scheduled jobs must be triggered externally.
# Add these to your crontab or Cloud Scheduler:
#
#   0 0 * * *  curl -sf -X POST http://localhost:8080/api/cron/resolve \
#                -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'
#
#   10 0 * * *  curl -sf -X POST http://localhost:8080/api/cron/refresh \
#                -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'
