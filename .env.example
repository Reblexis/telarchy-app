# ── Required ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://telarchy:changeme@localhost:5432/telarchy

# Master API key — keep secret. Used for admin access and cron endpoints.
# Generate with: openssl rand -hex 32
API_KEY=your-secret-api-key-here
# During a master-key rotation set the OLD key here for up to 24 hours so every
# caller can move to the new API_KEY without a simultaneous cutover; then unset it.
# See docs/infra/deploy.md, "Master key rotation".
API_KEY_PREVIOUS=

# Secret used by BetterAuth to sign session tokens.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Credits granted to every new participant on signup. Default 1000.
# Set 0 to issue credits only through admin crediting or transfers.
#SIGNUP_CREDITS=1000

# Enable real USDC deposits and withdrawals. When "false" (default), deposit,
# withdraw, wallet, and treasury endpoints return 503 and credits are play-money
# only. Managed telarchy.com runs with this off; self-hosted and enterprise
# instances set it to "true" to unlock USDC settlement.
USDC_SETTLEMENT_ENABLED=false

# Treasury wallet private key for USDC withdrawals on Base mainnet.
# Only used when USDC_SETTLEMENT_ENABLED=true.
TREASURY_PRIVATE_KEY=0x...

# ── Optional ──────────────────────────────────────────────────────────────────

# Browser origins: unset or empty or * = allow any. Otherwise comma-separated exact origins (https://…).
# Example: ALLOWED_ORIGIN=https://app.example.com,https://www.app.example.com
ALLOWED_ORIGIN=
# Optional extra origins (merged with ALLOWED_ORIGIN). Set BETTER_AUTH_URL to the same public URL you use in the browser.
# BETTER_AUTH_URL=
# AUTH_COOKIE_DOMAIN=
# TRUSTED_ORIGINS=
# ALLOW_LOCALHOST_CORS=

# Comma-separated admin email addresses
# Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=

# Docker Compose: PostgreSQL password (for db service)
DB_PASSWORD=changeme

# OAuth providers (optional — email/password auth always enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HTTP port (default: 8080)
PORT=8080

# ── Cron (self-hosted only) ────────────────────────────────────────────────────
# Scheduled jobs must be triggered externally. Add to crontab or Cloud Scheduler:
#
#   0 0 * * *   curl -sf -X POST http://localhost:8080/api/cron/resolve \
#                 -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'
#
#   10 0 * * *  curl -sf -X POST http://localhost:8080/api/cron/refresh \
#                 -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'
