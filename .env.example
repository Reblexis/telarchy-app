# Telarchy configuration. One file for the whole repo: `cp .env.example .env`.
# docker compose reads it for the containers; the backend loads it from the
# repository root (or from functions/ if you start it there); Vite reads the
# VITE_* lines. Every variable the code reads is listed here.

# ── Required ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string. docker compose builds its own from DB_PASSWORD.
DATABASE_URL=postgres://telarchy:changeme@localhost:5432/telarchy

# Master API key: platform admin on every workspace and the cron endpoints.
# Generate with: openssl rand -hex 32
API_KEY=your-secret-api-key-here
# During a master-key rotation set the OLD key here for up to 24 hours so every
# caller can move to the new API_KEY without a simultaneous cutover; then unset it.
# See docs/infra/deploy.md, "Master key rotation".
API_KEY_PREVIOUS=

# Secret used by BetterAuth to sign session tokens. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# ── Instance identity ──────────────────────────────────────────────────────────

# Public URL of this instance, used in share cards, notification links and the
# operator handoff text. Falls back to BETTER_AUTH_URL, then https://telarchy.com.
PUBLIC_ORIGIN=http://localhost:8080
# The same public URL, for BetterAuth (cookies and OAuth callbacks).
BETTER_AUTH_URL=http://localhost:8080
# Hostnames that serve the real thing (comma-separated); everything else is a preview.
# Default: telarchy.com,www.telarchy.com
PROD_HOSTS=
# From header for outbound mail; the domain must be verified at Resend.
# Default: Telarchy <floor@telarchy.com>
MAIL_FROM=
# Contact named in the privacy policy and terms. Default: the managed instance's.
PRIVACY_CONTACT=
# Where owner notifications (waitlist signups, new proposals) are mailed.
OWNER_NOTIFY_EMAIL=
# Resend API key for outbound mail. Unset = mail is logged and not sent.
RESEND_API_KEY=

# ── Browser origins ────────────────────────────────────────────────────────────

# Unset, empty or * = allow any origin. Otherwise comma-separated exact origins.
ALLOWED_ORIGIN=
# AUTH_COOKIE_DOMAIN=.example.com   when the apex and www both serve the app
# TRUSTED_ORIGINS=                  extra origins merged with ALLOWED_ORIGIN
# ALLOW_LOCALHOST_CORS=true         lets a Vite dev server on localhost call the API

# ── Docker compose ─────────────────────────────────────────────────────────────

DB_PASSWORD=changeme
DB_PORT=5432
PORT=8080
# Run the database migrations on container start (compose sets this; the
# managed deploy migrates in its deploy workflow instead).
AUTO_MIGRATE=true

# ── Credits and accounts ───────────────────────────────────────────────────────

# Credits granted on signup, priced by what the account brings (2026-08-28):
# SIGNUP_CREDITS for user accounts (default 10000; 0 = only through admin
# crediting or transfers), AGENT_SIGNUP_CREDITS for API registrations and
# sub-bots (default 0; owners fund agents by transfer).
# UNCLAIMED_SIGNUP_CREDITS is the grant for participants registered by key
# before a human claims them.
#SIGNUP_CREDITS=10000
#AGENT_SIGNUP_CREDITS=0
#UNCLAIMED_SIGNUP_CREDITS=
# First platform admin, created on boot when the account does not exist yet.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# OWNER_ONBOARDING_OPEN=true   opens the operator door to strangers

# ── Real-money settlement (self-hosted only) ──────────────────────────────────

# When "false" (default), deposit, withdraw, wallet and treasury endpoints return
# 503 and credits are play-money. When "true", TREASURY_PRIVATE_KEY (a Base
# mainnet wallet holding the USDC reserve) is required at boot. Never a funded
# wallet you use for anything else. You are responsible for your own compliance.
USDC_SETTLEMENT_ENABLED=false
TREASURY_PRIVATE_KEY=

# ── OAuth sign-in (optional; email + password is always on) ───────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App for metric sources (optional) ──────────────────────────────────

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# ── Otto, the in-app assistant (optional) ─────────────────────────────────────

# Without a key the assistant is off; the rest of the app works.
AI_GATEWAY_API_KEY=
# ASK_MODEL=            model for /ask   # SEARCH_MODEL=   # JUDGE_MODEL=   # SETUP_EFFORT=

# ── Web push (optional) ────────────────────────────────────────────────────────

# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Rate limits (optional, per 15 minutes per IP unless noted) ───────────────

# RATE_LIMIT_MAX=   REGISTRATION_LIMIT_MAX=   FEEDBACK_LIMIT_MAX=   ASK_LIMIT_MAX=

# ── Frontend (Vite) ────────────────────────────────────────────────────────────

# API base for the browser. Empty = same origin (the server serves the app).
VITE_API_URL=
# Link to the source repository in the footer; set once the source is public.
VITE_PUBLIC_REPO_URL=

# ── Managed instance only (Cloud Run); ignore when self-hosting ───────────────

# DATABASE_BETA_URL=   SELF_BASE_URL=   (CLOUD_RUN_REGION, GCLOUD_PROJECT, K_SERVICE,
# K_REVISION are set by Cloud Run itself)

# ── Cron (self-hosted) ─────────────────────────────────────────────────────────
# Scheduled jobs are triggered externally. Add to crontab or any scheduler:
#
#   0 0 * * *   curl -sf -X POST http://localhost:8080/api/cron/resolve \
#                 -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'
#
#   10 0 * * *  curl -sf -X POST http://localhost:8080/api/cron/refresh \
#                 -H "X-API-Key: $API_KEY" -H "Content-Type: application/json" -d '{}'

# ── Paid liquidity (Stripe) ────────────────────────────────────────────────────
# Both unset = liquidity purchases disabled (every purchase surface answers
# 503). See docs/liquidity-purchases.md.
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
# Provisional price, owner to confirm before the first sale.
#LIQUIDITY_CREDITS_PER_USD=100
