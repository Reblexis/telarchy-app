{
  "name": "telarchy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-guides.mjs && tsc -b && vite build",
    "build:guides": "node scripts/build-guides.mjs",
    "knip": "knip",
    "build:functions": "npm --prefix functions run build",
    "predeploy": "node scripts/build-changelog.mjs",
    "deploy": "gcloud run deploy api --source . --region us-central1 --allow-unauthenticated --memory 512Mi --cpu 1 --min-instances 0 --max-instances 4 --set-cloudsql-instances telarchy-e0043:us-central1:telarchy-pg --clear-base-image",
    "preview": "vite preview",
    "dev:local": "npm run build:functions && concurrently -n emu,vite,tsc -c blue,green,yellow \"npx firebase-tools emulators:start --only functions\" \"vite\" \"npm --prefix functions run watch\"",
    "test": "npm --prefix functions run test && npm run test:frontend",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:integration": "node scripts/test-integration.ts",
    "test:db": "npx tsx scripts/test-db-consistency.ts",
    "migrate:participants": "node scripts/migrate-participant-identity.mjs",
    "test:ci": "npm --prefix functions run test:ci && npm run test:frontend",
    "typecheck": "tsc -b && npm --prefix functions run build",
    "build:beta": "BASE_PATH=/beta/ VITE_API_URL=/beta vite build --outDir dist-beta"
  },
  "dependencies": {
    "better-auth": "^1.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.6.0",
    "jsdom": "^29.0.2",
    "knip": "^6.32.2",
    "pg": "^8.20.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
