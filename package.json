{
  "name": "telarchy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "npm --prefix functions run build",
    "deploy": "gcloud run deploy api --source . --region us-central1 --allow-unauthenticated --memory 256Mi --cpu 1 --min-instances 1 --max-instances 20 --set-cloudsql-instances telarchy-e0043:us-central1:telarchy-pg --clear-base-image",
    "preview": "vite preview",
    "dev:local": "npm run build:functions && concurrently -n emu,vite,tsc -c blue,green,yellow \"npx firebase-tools emulators:start --only functions\" \"vite\" \"npm --prefix functions run watch\"",
    "test": "npm --prefix functions run test",
    "test:integration": "node scripts/test-integration.ts",
    "test:db": "npx tsx scripts/test-db-consistency.ts",
    "migrate:participants": "node scripts/migrate-participant-identity.mjs"
  },
  "dependencies": {
    "better-auth": "^1.5.6",
    "chart.js": "^4.4.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "hammerjs": "^2.0.8",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.6.0",
    "pg": "^8.20.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
