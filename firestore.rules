rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Metrics collection - stores all user metrics
    match /metrics/{metricId} {
      allow read, write: if request.auth != null;
    }
    
    // Updates collection - stores metric update history
    match /updates/{updateId} {
      allow read, write: if request.auth != null;
    }
    
    // System collection - stores system data like lastDecay
    match /system/{document} {
      allow read, write: if request.auth != null;
    }
    
    // MetricLogs collection - stores historical metric values for graphing
    match /metricLogs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}


