# Copy to `.env` for shared defaults, or `.env.local` for per-machine overrides.
# Loading order in `node lib/server.js`: `.env` first, then `.env.local` takes
# precedence (Next.js / Vite convention). `.env.local` is gitignored.
DATABASE_URL=postgres://telarchy:changeme@localhost:5432/telarchy
API_KEY=your-secret-api-key-here
BETTER_AUTH_SECRET=your-better-auth-secret-here
TREASURY_PRIVATE_KEY=0x...

# ── First-boot admin (GitLab-style) ──────────────────────────────────────────
# On first start (empty database), Telarchy creates an initial admin account.
# If INITIAL_ADMIN_PASSWORD is not set, a password is auto-generated and
# printed to stdout — save it before the container restarts.
INITIAL_ADMIN_EMAIL=admin@localhost
# INITIAL_ADMIN_PASSWORD=change-me

# ── Public origin ─────────────────────────────────────────────────────────────
# Required when running behind a reverse proxy or on a custom domain.
# Must be the exact scheme+host users type in the browser (no trailing slash).
# Used for OAuth redirect_uri and cookie scope.
# BETTER_AUTH_URL=https://your-domain.com

# Optional: align auth cookies across apex and www (leading dot required).
# AUTH_COOKIE_DOMAIN=.your-domain.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Unset, empty, or "*" → allow all origins (default, fine for single-user).
# Comma-separated exact origins to restrict:
# ALLOWED_ORIGIN=https://your-domain.com,https://www.your-domain.com
# TRUSTED_ORIGINS=
# Set to 1 to allow http://localhost:* when ALLOWED_ORIGIN is restricted:
# ALLOW_LOCALHOST_CORS=

# ── OAuth providers (optional) ────────────────────────────────────────────────
# Enable Google or GitHub sign-in by setting both ID and secret.
# BETTER_AUTH_URL must be set when using OAuth on a custom domain.
#
# Register these callback URLs in your OAuth app console:
#   Google:  {BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub:  {BETTER_AUTH_URL}/api/auth/callback/github
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Firebase production: these must exist as Secret Manager secrets (same names).
# From repo root (after firebase login / firebase use):
#   ./scripts/push-oauth-secrets-firebase.sh
# Or interactively: firebase functions:secrets:set GOOGLE_CLIENT_ID
