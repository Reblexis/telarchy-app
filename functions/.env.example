DATABASE_URL=postgres://telarchy:changeme@localhost:5432/telarchy
API_KEY=your-secret-api-key-here
BETTER_AUTH_SECRET=your-better-auth-secret-here
TREASURY_PRIVATE_KEY=0x...
ADMIN_EMAILS=you@example.com

# Public origin users type in the browser (OAuth redirect_uri, cookie scope). Required in production behind a proxy.
# BETTER_AUTH_URL=https://your-domain.com
# Optional registrable domain for cookies when apex and www both serve the app (leading dot), e.g. Google OAuth state:
# AUTH_COOKIE_DOMAIN=.your-domain.com
# When ALLOWED_ORIGIN is not *, list every frontend origin (comma-separated). Optional extras:
# TRUSTED_ORIGINS=
# Local dev with a locked-down ALLOWED_ORIGIN: set to 1 to allow http://localhost:* / 127.0.0.1
# ALLOW_LOCALHOST_CORS=

# OAuth providers (optional — local dev)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Firebase production: these four must exist as Secret Manager secrets (same names) or deploy
# will fail after they are wired in functions/src/index.ts. Plain functions/.env is not uploaded.
# From repo root (after firebase login / firebase use):
#   ./scripts/push-oauth-secrets-firebase.sh
# Or interactively: firebase functions:secrets:set GOOGLE_CLIENT_ID

# Treasury wallet private key for USDC withdrawals on Base mainnet.
# Required for a valid treasury-backed Telarchy server.
