API_KEY=your-secret-api-key-here

# Optional: base64-encoded service account JSON from an external Firebase project.
# If set, functions will use this credential for Firestore — allowing the app to be
# hosted on one Firebase project while data lives in another.
#
# How to generate:
#   1. Firebase Console → external project → Project Settings → Service Accounts
#   2. Click "Generate new private key" → download JSON
#   3. base64 -w 0 path/to/service-account.json
#   4. Paste the result below
#
# DATA_SERVICE_ACCOUNT=
